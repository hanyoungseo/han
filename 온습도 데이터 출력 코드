#include <DHT.h>

#define DHTPIN 8
#define DHTTYPE DHT11

DHT dht(DHTPIN, DHTTYPE);

float temperature = 0;
float humidity = 0;

void setup() {
  Serial.begin(9600);
  dht.begin();

  Serial.println("DHT11 Temperature and Humidity Monitoring Start");
}

void loop() {
  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("Failed to read data from DHT sensor");
    delay(2000);
    return;
  }

  printSensorData();
  checkEnvironmentStatus();

  delay(2000);
}

void printSensorData() {
  Serial.println("========== Sensor Data ==========");

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  Serial.println("=================================");
}

void checkEnvironmentStatus() {
  if (temperature >= 30) {
    Serial.println("Temperature Status: High");
  } 
  else if (temperature <= 18) {
    Serial.println("Temperature Status: Low");
  } 
  else {
    Serial.println("Temperature Status: Normal");
  }

  if (humidity >= 80) {
    Serial.println("Humidity Status: High");
  } 
  else if (humidity <= 40) {
    Serial.println("Humidity Status: Low");
  } 
  else {
    Serial.println("Humidity Status: Normal");
  }

  Serial.println();
}
